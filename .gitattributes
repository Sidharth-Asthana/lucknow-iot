# Normalise all text files to LF in the repo (works on both Windows and macOS)
* text=auto eol=lf

# Force LF for shell scripts and Arduino sketches
*.sh     text eol=lf
*.ino    text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.plist  text eol=lf

# Binary files — do not touch
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.blend  binary
