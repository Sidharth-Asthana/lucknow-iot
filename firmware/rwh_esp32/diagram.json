    [ "esp32:GND",    "btn_flow_bh:2.l",  "black",  [] ],

    [ "esp32:GPIO27", "led_pump:A",        "red",    [] ],
    [ "esp32:GPIO26", "led_valve_dom:A",   "blue",   [] ],
    [ "esp32:GPIO25", "led_valve_bh:A",    "cyan",   [] ],
    [ "esp32:GND",    "led_pump:K",        "black",  [] ],
    [ "esp32:GND",    "led_valve_dom:K",   "black",  [] ],
    [ "esp32:GND",    "led_valve_bh:K",    "black",  [] ]
