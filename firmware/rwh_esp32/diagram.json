    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_flow_dom",
      "top": -80,
      "left": 220,
      "attrs": {
        "color": "blue",
        "label": "YF-S201 domestic flow pulse"
      }
    },
    {
      "type": "wokwi-pushbutton",
